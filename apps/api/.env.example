NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Transactions (used by the outbox) need a replica set. `pnpm dev:db` starts one locally.
MONGO_URI=mongodb://127.0.0.1:27017/taskflow?replicaSet=rs0&directConnection=true
# Required in production (rate-limit counters must not live in process memory).
REDIS_URL=
CORS_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-bytes-minimum
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
# Optional: outbox worker POSTs events here (HMAC-signed with OUTBOX_WEBHOOK_SECRET).
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_SECRET=
# Optional: enables OpenTelemetry traces + metrics over OTLP/HTTP.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=taskflow-api
