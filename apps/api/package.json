{
  "name": "@taskflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm migrate && tsx watch --env-file=.env --import ./src/common/otel.ts src/server.ts",
    "dev:worker": "tsx watch --env-file=.env --import ./src/common/otel.ts src/worker.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "migrate": "tsx --env-file=.env src/migrations/run.ts",
    "build": "tsup",
    "start": "node --import ./dist/common/otel.js dist/server.js",
    "start:worker": "node --import ./dist/common/otel.js dist/worker.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:server": "tsx scripts/e2e-server.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@taskflow/contracts": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "opossum": "^10.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "../../node_modules/.cache/mongodb-memory-server"
    }
  }
}
