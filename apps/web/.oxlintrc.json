{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }],
    "react/exhaustive-deps": "warn",
    "no-console": "error",
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/pages/*/**"],
            "message": "Import another page module through its public index.ts only (e.g. '@/pages/auth')."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.test.tsx", "src/**/*.test.ts", "src/test/**", "e2e/**"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
